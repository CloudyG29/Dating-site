generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlserver"
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  phone     String?
  createdAt DateTime @default(now())
  matchesA  Match[]  @relation("MatchUserA")
  matchesB  Match[]  @relation("MatchUserB")
  profile   Profile?
}

model Profile {
  id            String   @id @default(cuid())
  userId        String   @unique
  displayAlias  String   @unique
  bio           String?
  isActive      Boolean  @default(true)
  values        String?
  goals         String?
  lifestyleTags String?
  dealbreakers  String?
  createdAt     DateTime @default(now())
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Match {
  id                 String    @id @default(cuid())
  userAId            String
  userBId            String
  compatibilityScore Float
  status             String    @default("PENDING_REVIEW")
  userAConsent       String    @default("PENDING")
  userBConsent       String    @default("PENDING")
  revealedAt         DateTime?
  createdAt          DateTime  @default(now())
  userA              User      @relation("MatchUserA", fields: [userAId], references: [id], onUpdate: NoAction)
  userB              User      @relation("MatchUserB", fields: [userBId], references: [id], onUpdate: NoAction)

  @@unique([userAId, userBId])
}
